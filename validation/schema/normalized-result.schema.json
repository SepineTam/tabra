{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tabra.dev/schemas/normalized-result.schema.json",
  "title": "Tabra three-engine normalized validation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command",
    "engine",
    "status",
    "converged",
    "skipped",
    "sample",
    "metrics",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "command": {"type": "string", "minLength": 1},
    "engine": {"enum": ["python", "stata", "r"]},
    "status": {"enum": ["completed", "failed", "skipped"]},
    "converged": {"type": "boolean"},
    "skipped": {"type": "boolean"},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nobs", "data_sha256"],
      "properties": {
        "nobs": {"type": "integer", "minimum": 0},
        "data_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "engine_version",
        "dataset_path",
        "case_status",
        "cases_sha256",
        "case_execution"
      ],
      "properties": {
        "engine_version": {"type": "string", "minLength": 1},
        "dataset_path": {"type": "string", "minLength": 1},
        "cases_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "case_status": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["completed", "failed", "skipped"]}
        },
        "case_execution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "seed",
              "included_row_sha256",
              "omitted_parameters"
            ],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "seed": {"type": "integer"},
              "included_row_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "omitted_parameters": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
